{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "rubber-band-bumper",
  "type": "hyperframes:component",
  "title": "Rubber Band Bumper",
  "description": "An outgoing panel pulls against increasing resistance, holds at tension, then snaps past an edge with overshoot as the incoming panel settles behind it.",
  "tags": ["motion-primitive", "transition", "rubber-band", "resistance", "overshoot"],
  "jobs": ["bridge"],
  "family": "transitions",
  "profile": "elastic",
  "syncPoints": [
    {
      "id": "release",
      "phase": "out",
      "offset": 0
    }
  ],
  "files": [
    {
      "path": "rubber-band-bumper.html",
      "target": "compositions/components/rubber-band-bumper.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "direction",
      "type": "enum",
      "role": "content",
      "label": "Direction",
      "description": "Edge the outgoing panel releases through.",
      "default": "up",
      "options": [
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "id": "out_kicker",
      "type": "string",
      "role": "content",
      "label": "Outgoing kicker",
      "description": "Empty hides the line.",
      "default": "СЕЙЧАС"
    },
    {
      "id": "out_title",
      "type": "string",
      "role": "content",
      "label": "Outgoing title",
      "description": "Empty hides the line.",
      "default": "Держим натяжение"
    },
    {
      "id": "out_subtitle",
      "type": "string",
      "role": "content",
      "label": "Outgoing subtitle",
      "description": "Empty hides the line.",
      "default": "С каждым рывком сопротивление сильнее"
    },
    {
      "id": "in_kicker",
      "type": "string",
      "role": "content",
      "label": "Incoming kicker",
      "description": "Empty hides the line.",
      "default": "ДАЛЬШЕ"
    },
    {
      "id": "in_title",
      "type": "string",
      "role": "content",
      "label": "Incoming title",
      "description": "Empty hides the line.",
      "default": "Отпустили"
    },
    {
      "id": "in_subtitle",
      "type": "string",
      "role": "content",
      "label": "Incoming subtitle",
      "description": "Empty hides the line.",
      "default": "Новая сцена встаёт за рывком"
    }
  ]
}

{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "text-match-cut",
  "type": "hyperframes:component",
  "title": "Text Match Cut",
  "description": "One line of text becomes another mid-move: both ride a single 85 % easy-ease curve and hard-swap at the speed peak, as scale, tracking, or a same-direction slide; a brand-red bar sweeps the glyphs through the cut.",
  "tags": ["motion-primitive", "transition", "typography", "match-cut", "hard-cut", "continuity"],
  "jobs": ["connect"],
  "family": "transitions",
  "profile": "transition",
  "syncPoints": [
    {
      "id": "hard-cut",
      "phase": "in",
      "offset": 1.0
    }
  ],
  "files": [
    {
      "path": "text-match-cut.html",
      "target": "compositions/components/text-match-cut.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "text_a",
      "type": "string",
      "role": "content",
      "label": "Outgoing text",
      "description": "The line on screen before the cut.",
      "default": "Обычный монтаж"
    },
    {
      "id": "text_b",
      "type": "string",
      "role": "content",
      "label": "Incoming text",
      "description": "The line that continues the move after the cut.",
      "default": "Монтаж с ИИ"
    },
    {
      "id": "mode",
      "type": "enum",
      "role": "style",
      "label": "Move",
      "description": "Which property carries the cut. Both texts ride the same curve.",
      "default": "scale-down",
      "options": [
        {
          "value": "scale-down",
          "label": "Scale down (tutorial)"
        },
        {
          "value": "scale-up",
          "label": "Scale up"
        },
        {
          "value": "tracking-in",
          "label": "Tracking in"
        },
        {
          "value": "slide-left",
          "label": "Slide left"
        },
        {
          "value": "slide-right",
          "label": "Slide right"
        },
        {
          "value": "slide-up",
          "label": "Slide up"
        },
        {
          "value": "slide-down",
          "label": "Slide down"
        }
      ]
    },
    {
      "id": "sweep",
      "type": "enum",
      "role": "style",
      "label": "Gradient sweep",
      "description": "Brand-red bar sweeping through the glyphs around the cut.",
      "default": "on",
      "options": [
        {
          "value": "on",
          "label": "On"
        },
        {
          "value": "off",
          "label": "Off"
        }
      ]
    },
    {
      "id": "background",
      "type": "enum",
      "role": "style",
      "label": "Background",
      "description": "A dark brand-red glow from below, or transparent so the host shows through.",
      "default": "transparent",
      "options": [
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        }
      ]
    }
  ]
}

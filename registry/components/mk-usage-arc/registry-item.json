{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "mk-usage-arc",
  "type": "hyperframes:component",
  "title": "Hairline Arc Gauge",
  "description": "Hairline circular gauge filling the host box: the arc draws on to a value while the centred number counts up, a small label under it.",
  "tags": ["data-viz", "gauge", "minimal", "vertical"],
  "files": [
    {
      "path": "mk-usage-arc.html",
      "target": "compositions/components/mk-usage-arc.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "value",
      "type": "number",
      "role": "content",
      "label": "Value",
      "description": "Arc fill and counted number, 0 to 100 percent.",
      "default": 76,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "id": "label",
      "type": "string",
      "role": "content",
      "label": "Label",
      "description": "Small label under the number.",
      "default": "Загрузка",
      "maxLength": 16
    }
  ]
}
